@startuml
class SettingsManager <<static>> {
    + {static} DefaultFileName : string = "settings.json"
    + {static} GetDefaultPath() : string
    + {static} Save(settings:Settings, filePath:string?) : void
    + {static} Load(filePath:string?) : Settings
}
class SafeStringEnumConverter {
    + <<override>> ReadJson(reader:JsonReader, objectType:Type, existingValue:object?, serializer:JsonSerializer) : object?
}
SettingsManager +-- SafeStringEnumConverter
StringEnumConverter <|-- SafeStringEnumConverter
@enduml
